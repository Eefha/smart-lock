# ============================================================
# 复制为 secrets.env 后填写，并执行 chmod 600 secrets.env
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
# 该文件含明文密钥，切勿上传 Git / 截图外发。
#
# config.py 会在使用任何配置之前自动读取**同目录**的 secrets.env，
# 所以裸 nohup 启动也能跑，不需要先 export；已有的环境变量优先级更高。
#   取值顺序：真实环境变量 > secrets.env > config.py 内置默认值
#
# 生成密钥（各跑一次）：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# 【必填】小程序用户令牌签名密钥；泄露 = 可伪造任意用户身份
TOKEN_SECRET=

# 【必填】管理后台调用 /open_lock 的内部密钥；tcp_server 与 admin_web 必须一致
INTERNAL_API_KEY=

# 【必填】Flask session 签名密钥（管理后台登录态）。留空则复用 TOKEN_SECRET
FLASK_SECRET_KEY=

# 【必填】后台初始管理员口令。仅在首次创建 admin 账号时生效；
#   留空则随机生成并在 admin.log 打印一次，登录后请立即改密。
ADMIN_INIT_PASSWORD=

# 【必填】微信小程序凭证，/wx/login 用它换真实 openid
WX_APPID=
WX_SECRET=

# 【选填】数据库。源码不内置任何口令，必须在这里或真实环境变量中提供 DB_PASSWORD，
# 否则服务会告警且连接失败。空值等价于未配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mercy
DB_PASSWORD=
DB_NAME=smart_lock
DB_POOL_SIZE=20

# 【选填】端口与阈值，一般不用改
TCP_PORT=8002
API_PORT=8001
ADMIN_PORT=8003
MAX_WORKERS=100
HEARTBEAT_TIMEOUT_SECONDS=600
OFFLINE_SCAN_INTERVAL=60
PAY_VALID_MINUTES=5
TOKEN_TTL_HOURS=168
